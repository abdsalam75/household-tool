{
  "name": "household-tool",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo start --dev-client --android",
    "ios": "expo start --dev-client --ios",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{js,cjs,mjs,jsx,ts,tsx,json}\"",
    "format:check": "prettier --check \"**/*.{js,cjs,mjs,jsx,ts,tsx,json}\"",
    "lint": "eslint .",
    "test": "jest",
    "build:invitation-pages": "node scripts/build-invitation-pages.mjs",
    "verify:invitation-deployment": "node scripts/verify-invitation-deployment.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "expo": "~57.0.24",
    "expo-dev-client": "~57.0.19",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "3.7.4",
    "typescript-eslint": "8.70.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo"
  }
}
