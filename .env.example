# Mobile public configuration. Copy to an ignored .env.local and use only the
# public anon key generated for the matching #6 environment.
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_SUPABASE_URL=http://localhost:8000
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-the-local-public-anon-key
# Local browser fallback origin. Staging and production must use their public
# HTTPS invitation origin and matching registered native identifiers.
EXPO_PUBLIC_INVITATION_ORIGIN=http://localhost
IOS_BUNDLE_IDENTIFIER=com.householdtool.mobile.local
ANDROID_PACKAGE_NAME=com.householdtool.mobile.local
